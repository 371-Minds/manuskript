# Manuskript AI Feature — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Required: AI provider API key
# The Manuskript MCP server and ADK agents read from MANUSKRIPT_AI_KEY first,
# then fall back to GOOGLE_API_KEY.
# ---------------------------------------------------------------------------
MANUSKRIPT_AI_KEY=your_api_key_here

# Alternatively, if you use the Google Generative AI SDK directly:
# GOOGLE_API_KEY=your_google_api_key_here

# ---------------------------------------------------------------------------
# Optional: Override the default model
# Default: gemini-2.0-flash
# ---------------------------------------------------------------------------
# MANUSKRIPT_AI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Optional: MCP server transport (stdio or sse)
# Default: stdio (recommended for local use)
# ---------------------------------------------------------------------------
# MANUSKRIPT_MCP_TRANSPORT=stdio
# MANUSKRIPT_MCP_PORT=8765
# MANUSKRIPT_MCP_HOST=127.0.0.1
